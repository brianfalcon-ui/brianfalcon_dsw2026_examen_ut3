meta {
  name: 16 - Crear aviso
  type: http
  seq: 16
}

post {
  url: {{baseUrl}}/api/v1/notices
  body: json
  auth: none
}

body:json {
  {
    "title": "  Aviso de Bruno  "
  }
}

script:post-response {
  bru.setVar("noticeId", res.getBody().data.id);
}

assert {
  res.status: eq 201
  res.body.data.title: eq Aviso de Bruno
  res.body.data.description: eq ""
  res.body.data.id: isString
  res.body.data.createdAt: isString
}
